/ {
	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;

			cpuflpr_code_partition: image@165000 {
				/* FLPR core code partition */
				reg = <0x165000 DT_SIZE_K(96)>;
			};

			cpuapp_cpuflpr_ipc_shm: memory@20027000 {
				reg = <0x20027000 DT_SIZE_K(2)>;
			};

			cpuflpr_cpuapp_ipc_shm: memory@20027800 {
				reg = <0x20027800 DT_SIZE_K(2)>;
			};
		};

		ipc {
			ipc0: ipc0 {
				compatible = "zephyr,ipc-icbmsg";
				dcache-alignment = <32>;
				tx-region = <&cpuapp_cpuflpr_ipc_shm>;
				rx-region = <&cpuflpr_cpuapp_ipc_shm>;
				tx-blocks = <4>;
				rx-blocks = <4>;
				mboxes = <&cpuapp_vevif_rx 20>, <&cpuapp_vevif_tx 21>;
				mbox-names = "rx", "tx";
				unbound = "detect";
				status = "okay";
			};
		};

		cpuflpr_sram_code_data: memory@20028000 {
			compatible = "mmio-sram";
			reg = <0x20028000 DT_SIZE_K(96)>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x20028000 0x18000>;
		};
	};
};

&uart30 {
	status = "reserved";
};

&cpuflpr_vpr {
	execution-memory = <&cpuflpr_code_partition>;
};

&cpuapp_vevif_tx {
	status = "okay";
};

&cpuapp_vevif_rx {
	status = "okay";
};
