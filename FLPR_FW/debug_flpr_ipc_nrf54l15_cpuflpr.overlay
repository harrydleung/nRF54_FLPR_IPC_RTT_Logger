/ {
	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;

			/* Keep these addresses and sizes identical to the CPUAPP overlay. */
			cpuapp_cpuflpr_ipc_shm: memory@20027000 {
				reg = <0x20027000 DT_SIZE_K(2)>;
			};

			cpuflpr_cpuapp_ipc_shm: memory@20027800 {
				reg = <0x20027800 DT_SIZE_K(2)>;
			};
		};

		ipc {
			ipc0: ipc0 {
				compatible = "zephyr,ipc-icbmsg";
				dcache-alignment = <32>;
				/* Reverse CPUAPP's directions so each TX region is the peer's RX. */
				tx-region = <&cpuflpr_cpuapp_ipc_shm>;
				rx-region = <&cpuapp_cpuflpr_ipc_shm>;
				tx-blocks = <4>;
				rx-blocks = <4>;
				mboxes = <&cpuflpr_vevif_rx 21>, <&cpuflpr_vevif_tx 20>;
				mbox-names = "rx", "tx";
				unbound = "detect";
				status = "okay";
			};
		};
	};
};

&cpuflpr_vevif_rx {
	status = "okay";
};

&cpuflpr_vevif_tx {
	status = "okay";
};
